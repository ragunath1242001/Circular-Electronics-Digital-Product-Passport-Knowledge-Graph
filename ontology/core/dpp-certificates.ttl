@prefix dpp: <https://example.org/dpp/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dpp/ontology/certificates>
    a owl:Ontology ;
    owl:imports <https://example.org/dpp/ontology/core> ;
    owl:versionIRI <https://example.org/dpp/ontology/certificates/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dct:title "DPP Certificates Ontology"@en .

dpp:certificateIdentifier a owl:DatatypeProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range xsd:string ; rdfs:label "certificate identifier"@en .
dpp:certificateType a owl:DatatypeProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range xsd:string ; rdfs:label "certificate type"@en .
dpp:issuedBy a owl:ObjectProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range dpp:CertificationBody ; rdfs:label "issued by"@en .
dpp:coversEntity a owl:ObjectProperty ;
    rdfs:domain dpp:Certificate ; rdfs:label "covers entity"@en .
dpp:validFrom a owl:DatatypeProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range xsd:date ; rdfs:label "valid from"@en .
dpp:validUntil a owl:DatatypeProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range xsd:date ; rdfs:label "valid until"@en .
dpp:evidenceUrl a owl:DatatypeProperty ;
    rdfs:domain dpp:Certificate ; rdfs:range xsd:anyURI ; rdfs:label "evidence URL"@en .

