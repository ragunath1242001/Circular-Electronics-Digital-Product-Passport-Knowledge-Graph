@prefix dpp: <https://example.org/dpp/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dpp/ontology/provenance>
    a owl:Ontology ;
    owl:imports <https://example.org/dpp/ontology/core> ;
    owl:versionIRI <https://example.org/dpp/ontology/provenance/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dct:title "DPP Provenance Ontology"@en .

dpp:ProvenanceRecord a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Provenance record"@en .
dpp:ImportActivity a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Import activity"@en .

dpp:hasProvenance a owl:ObjectProperty ; rdfs:range dpp:ProvenanceRecord ; rdfs:label "has provenance"@en .
dpp:hasEvidence a owl:ObjectProperty ; rdfs:range dpp:EvidenceDocument ; rdfs:label "has evidence"@en .
dpp:generatedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasGeneratedBy ; rdfs:label "generated by"@en .
dpp:derivedFrom a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:label "derived from"@en .
dpp:attributedTo a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAttributedTo ; rdfs:label "attributed to"@en .
dpp:sourceSystem a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "source system"@en .
dpp:confidenceScore a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "confidence score"@en .

