@prefix dpp: <https://example.org/dpp/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/dpp/ontology/units>
    a owl:Ontology ;
    owl:imports <https://example.org/dpp/ontology/core> ;
    owl:versionIRI <https://example.org/dpp/ontology/units/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dct:title "DPP Quantity Vocabulary Alignment"@en .

dpp:quantityValue a owl:ObjectProperty ; rdfs:range qudt:QuantityValue ; rdfs:label "quantity value"@en .

