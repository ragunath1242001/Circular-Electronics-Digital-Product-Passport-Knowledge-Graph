PREFIX dpp: <https://example.org/dpp/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?product ?name ?certificate ?validUntil WHERE {
  GRAPH ?graph {
    ?product a dpp:Smartphone ; dct:title ?name ; dpp:hasCertificate ?certificate .
    ?certificate dpp:validUntil ?validUntil .
    FILTER(?validUntil < NOW())
  }
}
