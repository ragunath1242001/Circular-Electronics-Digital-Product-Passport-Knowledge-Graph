PREFIX dpp: <https://example.org/dpp/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?product ?component ?material ?supplier ?origin WHERE {
  GRAPH ?graph {
    ?product a dpp:Smartphone ; dpp:containsComponent ?component .
    ?component dpp:containsMaterial ?material .
    ?material dpp:suppliedBy ?supplier ; dpp:originatesFrom ?origin .
  }
}
