PREFIX dpp: <https://example.org/dpp/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?product ?name ?material ?facility ?facilityName WHERE {
  GRAPH ?graph {
    ?product a dpp:Smartphone ; dct:title ?name ;
      dpp:containsComponent/dpp:containsMaterial ?material .
    ?material dpp:originatesFrom ?facility .
    OPTIONAL { ?facility dct:title ?facilityName }
  }
}
